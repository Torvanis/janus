{
  "name": "janus-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/ensure-deps.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/ensure-deps.mjs",
    "test": "vitest run",
    "lint": "eslint src vite.config.ts scripts && prettier --check src vite.config.ts eslint.config.js scripts && knip",
    "format": "prettier --write src vite.config.ts eslint.config.js scripts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.62.7",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "25.0.1",
    "knip": "^6.35.1",
    "prettier": "^3.9.6",
    "typescript": "5.7.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
